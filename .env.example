PORT=3000
JWT_SECRET=dev-secret
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Microsoft (Entra ID) sign-in — must match the client's VITE_MSAL_* values.
# TENANT_ID: "common" (any account), "organizations" (work/school only), or a directory GUID.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

DATABASE_URL=postgres://user:password@localhost:5432/opengnp_db

# Object storage for uploaded assets (form cover images). The bucket is created
# automatically on first use if it doesn't already exist, and is kept private —
# every read is gated by the same accessType checks as the form itself, never a
# direct/public MinIO URL.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=gnp-uploads
